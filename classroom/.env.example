# ─────────────────────────────────────────────────────────────
#  classroom — орчны хувьсагчид (.env.example)
#  Бодит утгуудаа .env файлд эсвэл deploy платформын
#  Environment Variables хэсэгт оруулна. .env-ийг git-д бүү оруул.
# ─────────────────────────────────────────────────────────────

# === Frontend (Vite) ===
# "true" бол бодит serverless API руу холбоно.
# Хоосон/false бол localStorage demo горимоор шууд ажиллана (тохиргоо шаардахгүй).
VITE_USE_API=false

# === Backend (Serverless функц) ===
# JWT токен баталгаажуулах нууц түлхүүр (урт, санамсаргүй тэмдэгт).
JWT_SECRET=change-me-to-a-long-random-string

# Google Sheets service account-ийн мэдээлэл.
# 1) Google Cloud Console → Service Account үүсгэ → JSON key татаж ав.
# 2) JSON доторх client_email, private_key-г энд хуул.
# 3) Зорилтот Google Sheet-ээ энэ client_email рүү "Editor" эрхээр Share хий.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# private_key-г нэг мөрөнд бичихдээ шинэ мөрийг \n гэж бич.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Зорилтот Google Sheet-ийн ID (URL-ийн /d/<ID>/edit хэсэг).
GOOGLE_SHEET_ID=your-google-sheet-id
